includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-beberlei-assert/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    paths:
        - app/
        - bootstrap/
    level: 3
    tmpDir: /tmp/phpstan

    # O Larastan nesta combinação (Laravel 13 / PHP 8.4) não mapeia
    # propriedades dinâmicas de Eloquent (casts, enums, colunas) e alguns
    # métodos de pacotes. Por isso desligamos a checagem de propriedades de
    # model e ignoramos os false-positives conhecidos abaixo.
    checkModelProperties: false
    checkMissingTypehints: true

    stubFiles:
        - stubs/richer-editor.stub.php

    ignoreErrors:
        # medialibrary: método nonQueued() não enxergado pelo PHPStan
        -
            message: '#Call to an undefined method Spatie\\Image\\Drivers\\ImageDriver::nonQueued\(\)#'
        # Carbon em casts datetime não reconhecido como Carbon nesta versão
        -
            message: '#Cannot call method (isFuture|isPast)\(\) on string#'
        -
            message: '#Cannot call method toIso8601String\(\) on string#'
        # Paginator methods do Laravel não reconhecidos
        -
            message: '#Call to an undefined method Illuminate\\Contracts\\Pagination\\LengthAwarePaginator::(getCollection|setCollection)\(\)#'
        # ConnectionInterface::getDriverName() não reconhecido
        -
            message: '#Call to an undefined method Illuminate\\Database\\ConnectionInterface::getDriverName\(\)#'
        # Filament RichEditor::maxHeight() (stub parcial do richer-editor)
        -
            message: '#Call to an undefined method Filament\\Forms\\Components\\RichEditor::maxHeight\(\)#'
        # Propriedades dinâmicas de Eloquent ($name, $slug) não mapeadas pelo Larastan
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$(name|slug)#'
        # Cast de enum (PageStatus/PostStatus) não reconhecido como enum nesta versão
        -
            message: '#Method .*::resolveDisplayStatus\(\) should return .* but returns string#'
        # Atribuição de enum em propriedade $status (cast de enum não mapeado)
        -
            message: '#Property .*::\$status \(string\) does not accept#'
        # Acesso a $value em objeto tratado como string (cast de enum)
        -
            message: '#Cannot access property \$value on string#'
        # Atribuição de Carbon em $published_at (cast datetime não mapeado)
        -
            message: '#Property .*::\$published_at \(string\|null\) does not accept#'
        # EmailRules retorna Unique que o PHPStan não casa com Rule
        -
            message: '#Method .*::emailRules\(\) should return .* but returns#'
        # PHPDoc @param referencing dynamic property ($gallery)
        -
            message: '#PHPDoc tag @param references unknown parameter: \$gallery#'
