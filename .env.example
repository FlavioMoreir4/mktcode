APP_NAME="MC - Marketing & Code"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==================================================
# DATABASE (CI SAFE)
# ==================================================

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ==================================================
# SESSION / CACHE / QUEUE (CI SAFE)
# ==================================================

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=array

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# ==================================================
# MAIL (SAFE DEFAULT)
# ==================================================

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==================================================
# TELEGRAM (REQUIRED FOR TESTS)
# ==================================================

TELEGRAM_BOT_TOKEN=fake-token
TELEGRAM_DEFAULT_CHAT_ID=123456

# ==================================================
# AWS (OPTIONAL)
# ==================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==================================================
# FRONTEND
# ==================================================

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
